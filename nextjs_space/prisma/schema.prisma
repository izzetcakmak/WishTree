generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/wishtree/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  walletAddress String?   @unique
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  wishes        Wish[]
  agents        Agent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wish {
  id            String        @id @default(cuid())
  content       String
  txHash        String?       @unique
  tokenId       Int?
  walletAddress String
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  analysis      WishAnalysis?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model WishAnalysis {
  id        String   @id @default(cuid())
  wishId    String   @unique
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  sentiment String
  category  String
  score     Float
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Agent {
  id              String            @id @default(cuid())
  agentTokenId    Int?              @unique
  name            String
  description     String
  agentType       String
  capabilities    String[]
  version         String            @default("1.0.0")
  metadataURI     String?
  ownerAddress    String
  txHash          String?           @unique
  status          String            @default("pending")
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  feedbacks       AgentFeedback[]
  validations     AgentValidation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model AgentFeedback {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  score       Int
  tag         String
  comment     String?
  validator   String
  txHash      String?  @unique
  createdAt   DateTime @default(now())
}

model AgentValidation {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requestHash   String   @unique
  requestURI    String?
  validator     String
  response      Int?
  responseTag   String?
  status        String   @default("pending")
  txHash        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
