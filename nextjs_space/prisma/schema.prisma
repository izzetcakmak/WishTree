generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/wishtree/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  walletAddress String?   @unique
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  agents        Agent[]
  sessions      Session[]
  wishes        Wish[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wish {
  id            String        @id @default(cuid())
  content       String
  txHash        String?       @unique
  tokenId       Int?
  walletAddress String
  userId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      String?
  claimed       Boolean       @default(false)
  claimedAt     DateTime?
  phoneWalletId String?
  totalBlessed  Float         @default(0)
  blessings     Blessing[]
  phoneWallet   PhoneWallet?  @relation(fields: [phoneWalletId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
  analysis      WishAnalysis?
}

model WishAnalysis {
  id        String   @id @default(cuid())
  wishId    String   @unique
  sentiment String
  category  String
  score     Float
  createdAt DateTime @default(now())
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Agent {
  id             String            @id @default(cuid())
  agentTokenId   Int?              @unique
  name           String
  description    String
  agentType      String
  capabilities   String[]
  version        String            @default("1.0.0")
  metadataURI    String?
  ownerAddress   String
  txHash         String?           @unique
  status         String            @default("pending")
  userId         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  criteria       Json?
  lastTickAt     DateTime?
  monthResetAt   DateTime?
  monthlyBudget  Float             @default(0)
  monthlySpent   Float             @default(0)
  onchainAgentId Int?              @unique
  walletAddress  String?
  walletId       String?
  user           User?             @relation(fields: [userId], references: [id])
  feedbacks      AgentFeedback[]
  validations    AgentValidation[]
  blessings      Blessing[]
}

model AgentFeedback {
  id        String   @id @default(cuid())
  agentId   String
  score     Int
  tag       String
  comment   String?
  validator String
  txHash    String?  @unique
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentValidation {
  id          String   @id @default(cuid())
  agentId     String
  requestHash String   @unique
  requestURI  String?
  validator   String
  response    Int?
  responseTag String?
  status      String   @default("pending")
  txHash      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model PhoneWallet {
  id             String   @id @default(cuid())
  phone          String   @unique
  circleWalletId String?  @unique
  walletAddress  String   @unique
  createdAt      DateTime @default(now())
  encryptedKey   String?
  wishes         Wish[]
}

model Blessing {
  id               String   @id @default(cuid())
  wishId           String
  blesserAddress   String
  amount           Float
  message          String?
  txHash           String?  @unique
  chainSource      String   @default("arc")
  gatewayDepositId String?
  agentId          String?
  createdAt        DateTime @default(now())
  agent            Agent?   @relation(fields: [agentId], references: [id])
  wish             Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
}

model ProcessedMessage {
  id          String   @id @default(cuid())
  twilioSid   String   @unique
  processedAt DateTime @default(now())
}

model GatewayDeposit {
  id             String   @id @default(cuid())
  depositAddress String
  wishId         String
  blesserAddress String
  amount         Float
  sourceChain    String
  status         String   @default("pending")
  blessingId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
